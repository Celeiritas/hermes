#!/usr/bin/env python3
"""A fake Janus for Hermes's tests. It follows the contract in docs/design.md (§3, "The Janus contract") and never
writes into the arrival:
    janus check --json <arrival dir>      reads meta.json and data; prints one JSON verdict on stdout
    exit 0 = pass · 10 = quarantine · 11 = duplicate · anything else = Janus failed (Hermes holds the arrival)
The verdict comes from HERMES_FAKE_JANUS when it is set (pass | quarantine | duplicate | fail | hang | garbage; "hang"
never returns, for timeout tests; "garbage" exits 0 with text that is not a verdict). Otherwise the file decides, and
like the real Janus every check runs, so one verdict can carry several reasons: a size that doesn't match meta.json
(integrity), a sha256 that doesn't (integrity) and an executable or script name (kind) each add their own sentence and
make it a quarantine; a name containing "duplicate" is a duplicate; anything else passes.
The answer also carries "kind" (from the file's ending: image, archive, audio, document, or null), "notes" (non-fatal
remarks: a .7z or .rar passes with "archive contents unchecked (.7z)") and "ms". HERMES_FAKE_JANUS_OLD=1 answers like
a Janus from before those fields: no kind, no notes, no ms. HERMES_FAKE_JANUS_NOTES holds JSON that is sent as "notes"
exactly as it is (several notes, or something that is not a list of sentences at all)."""
import hashlib
import json
import os
import sys
import time

VERSION = "0.0-fake"
EXIT = {"pass": 0, "quarantine": 10, "duplicate": 11, "fail": 1}
NEVER = (".exe", ".msi", ".bat", ".cmd", ".ps1", ".sh", ".com", ".scr", ".dll", ".py", ".js", ".vbs")
KINDS = {"image": (".png", ".jpg", ".jpeg", ".gif", ".webp"), "archive": (".zip", ".tar", ".gz", ".7z", ".rar"),
         "audio": (".mp3", ".flac", ".ogg"), "document": (".txt", ".md", ".pdf", ".json")}
OPAQUE = (".7z", ".rar")          # archives nobody can list without unpacking: they pass, with a note


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def check(arrival):
    started = time.monotonic()
    checks = {"route": "ok", "kind": "ok", "shape": "ok", "integrity": "ok"}
    reasons, notes = [], []
    try:
        with open(os.path.join(arrival, "meta.json")) as f:
            meta = json.load(f)
        data = os.path.join(arrival, "data")
        digest = sha256(data)
        size = os.path.getsize(data)
    except (OSError, ValueError) as e:
        print("janus: cannot read the arrival: %s" % e, file=sys.stderr)
        return "fail", {"verdict": "fail", "reasons": ["Janus could not read the arrival."], "sha256": None,
                        "janus": VERSION, "checks": checks}
    name = str(meta.get("name", "")).lower()
    ext = name[name.rfind("."):] if "." in name else ""
    kind = next((k for k, endings in KINDS.items() if ext in endings), None)
    if ext in OPAQUE:
        notes.append("archive contents unchecked (%s)" % ext)
    forced = os.environ.get("HERMES_FAKE_JANUS")
    if forced == "hang":
        time.sleep(3600)
    if forced == "garbage":
        print("not a verdict")
        sys.exit(0)
    if forced in EXIT:
        verdict = forced
        if verdict != "pass":
            reasons.append("The fake Janus was told to answer %s." % verdict)
    else:
        verdict = "pass"
        if size != meta.get("bytes"):                    # every check runs: each failure adds its own sentence
            checks["integrity"] = "fail"
            reasons.append("The file is %d bytes, not the %s the sender declared." % (size, meta.get("bytes")))
        if digest != meta.get("sha256"):
            checks["integrity"] = "fail"
            reasons.append("The file's SHA-256 does not match what the sender declared.")
        if name.endswith(NEVER):
            checks["kind"] = "fail"
            reasons.append("%s files are never allowed on any route." % ext)
        if reasons:
            verdict = "quarantine"
        elif "duplicate" in name:
            verdict = "duplicate"
            reasons.append("This file was already delivered.")
    out = {"verdict": verdict, "reasons": reasons, "sha256": digest, "janus": VERSION, "checks": checks}
    if os.environ.get("HERMES_FAKE_JANUS_NOTES"):
        notes = json.loads(os.environ["HERMES_FAKE_JANUS_NOTES"])
    if not os.environ.get("HERMES_FAKE_JANUS_OLD"):
        out.update(kind=kind, notes=notes, ms=int((time.monotonic() - started) * 1000))
    return verdict, out


def main(argv):
    if len(argv) != 4 or argv[1] != "check" or argv[2] != "--json":
        print("usage: janus check --json <arrival dir>", file=sys.stderr)
        return 2
    verdict, out = check(argv[3])
    print(json.dumps(out))
    return EXIT[verdict]


if __name__ == "__main__":
    sys.exit(main(sys.argv))
