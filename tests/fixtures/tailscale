#!/usr/bin/env python3
"""A fake tailscale for tests: `tailscale whois --json <ip>` answers like the real one. HERMES_FAKE_WHOIS=fail makes it
exit 1 with an error, =garbage makes it print something that isn't JSON."""
import json
import os
import sys

if sys.argv[1:3] != ["whois", "--json"] or len(sys.argv) != 4:
    print("usage: tailscale whois --json <ip>", file=sys.stderr)
    sys.exit(2)
mode = os.environ.get("HERMES_FAKE_WHOIS", "ok")
if mode == "fail":
    print("no match for IP " + sys.argv[3], file=sys.stderr)
    sys.exit(1)
if mode == "garbage":
    print("not json")
    sys.exit(0)
print(json.dumps({"Node": {"ID": 1, "Name": "desktop.example.ts.net.", "ComputedName": "desktop", "Addresses": [sys.argv[3]]},
                  "UserProfile": {"ID": 2, "LoginName": "you@example.com", "DisplayName": "You"}, "CapMap": None}))
